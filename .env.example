# Copia a .env para `docker compose up` local. En Coolify se fijan en la UI del recurso.
# Servidor Nuxt -> API FastAPI (interno del compose). No tocar en local.
API_UPSTREAM=http://api:8001
# URL que usa el NAVEGADOR para el websocket en vivo.
# Local: ws://localhost:8001/ws/live (api publicado en 8001).
# Coolify: wss://<dominio-del-servicio-api>/ws/live (api debe tener dominio propio).
NUXT_PUBLIC_WS_URL=ws://localhost:8001/ws/live
# Alertas Telegram M4.5+ (opcional; sin esto el actor hace dry-run en log).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Google Maps JS API para /mapa (llave publica del navegador; restringela por
# referrer HTTP en Google Cloud Console). En Coolify va en la UI del recurso web.
NUXT_PUBLIC_GOOGLE_MAPS_KEY=
# Push vertexdc (SOLO secreto de servidor: UI de Coolify o data/push.json
# {"site_key":...} en local — NUNCA commitear, NUNCA exponer al navegador).
NOTIFICATIONS_SITE_KEY=
# NOTIFICATIONS_URL=https://notifications.vertexdc.com
